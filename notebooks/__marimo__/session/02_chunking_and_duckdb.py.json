dle\">#3</text></g><g><rect x=\"247.7\" y=\"48\" width=\"84.8\" height=\"16\" rx=\"4\" fill=\"#c084fc\" opacity=\"0.88\" stroke=\"#020617\" stroke-width=\"1\"><title>Chunk #4 (2. Storing Fixed-Size Embeddings in DuckDB (Part 2)) \u00b7 chars 878..1309 (431 chars, overlap=60)</title></rect><text x=\"290.1\" y=\"59.5\" fill=\"#020617\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\" text-anchor=\"middle\">#4</text></g><g><rect x=\"332.9\" y=\"72\" width=\"87.5\" height=\"16\" rx=\"4\" fill=\"#f472b6\" opacity=\"0.88\" stroke=\"#020617\" stroke-width=\"1\"><title>Chunk #5 (3. Troubleshooting Common DuckDB Vector Errors (Part 1)) \u00b7 chars 1311..1756 (445 chars, overlap=0)</title></rect><text x=\"376.6\" y=\"83.5\" fill=\"#020617\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\" text-anchor=\"middle\">#5</text></g><g><rect x=\"408.6\" y=\"96\" width=\"85.0\" height=\"16\" rx=\"4\" fill=\"#38bdf8\" opacity=\"0.88\" stroke=\"#020617\" stroke-width=\"1\"><title>Chunk #6 (3. Troubleshooting Common DuckDB Vector Errors (Part 2)) \u00b7 chars 1696..2128 (432 chars, overlap=60)</title></rect><text x=\"451.1\" y=\"107.5\" fill=\"#020617\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\" text-anchor=\"middle\">#6</text></g><g><rect x=\"494.0\" y=\"48\" width=\"88.3\" height=\"16\" rx=\"4\" fill=\"#60a5fa\" opacity=\"0.88\" stroke=\"#020617\" stroke-width=\"1\"><title>Chunk #7 (4. DuckDB Full-Text Search (BM25) and the `vss` Extension (Part 1)) \u00b7 chars 2130..2579 (449 chars, overlap=0)</title></rect><text x=\"538.1\" y=\"59.5\" fill=\"#020617\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\" text-anchor=\"middle\">#7</text></g><g><rect x=\"570.5\" y=\"72\" width=\"64.3\" height=\"16\" rx=\"4\" fill=\"#2dd4bf\" opacity=\"0.88\" stroke=\"#020617\" stroke-width=\"1\"><title>Chunk #8 (4. DuckDB Full-Text Search (BM25) and the `vss` Extension (Part 2)) \u00b7 chars 2519..2846 (327 chars, overlap=60)</title></rect><text x=\"602.6\" y=\"83.5\" fill=\"#020617\" font-size=\"10\" font-weight=\"bold\" font-family=\"monospace\" text-anchor=\"middle\">#8</text></g> <line x1=\"10\" y1=\"132\" x2=\"650\" y2=\"132\" stroke=\"#1e293b\" stroke-width=\"1\"/> <text x=\"10\" y=\"158\" fill=\"#94a3b8\" font-size=\"10\" font-family=\"monospace\">Chunk Size</text> <text x=\"10\" y=\"172\" fill=\"#64748b\" font-size=\"9.5\" font-family=\"monospace\">(chars)</text> <line x1=\"75\" y1=\"148.0\" x2=\"635\" y2=\"148.0\" stroke=\"#f43f5e\" stroke-width=\"1.2\" stroke-dasharray=\"4 3\"/> <text x=\"635\" y=\"144.0\" fill=\"#fda4af\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"end\">max_size=450</text> <line x1=\"75\" y1=\"216\" x2=\"635\" y2=\"216\" stroke=\"#334155\" stroke-width=\"1\"/> <g><rect x=\"91.0\" y=\"210.1\" width=\"38.0\" height=\"5.9\" rx=\"3\" fill=\"#38bdf8\"><title>Chunk #1: 39 chars (7 words)</title></rect><text x=\"110.0\" y=\"206.1\" fill=\"#cbd5e1\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">39</text><text x=\"110.0\" y=\"228.0\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">#1</text></g><g><rect x=\"161.0\" y=\"148.2\" width=\"38.0\" height=\"67.8\" rx=\"3\" fill=\"#60a5fa\"><title>Chunk #2: 449 chars (63 words)</title></rect><text x=\"180.0\" y=\"144.2\" fill=\"#cbd5e1\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">449</text><text x=\"180.0\" y=\"228.0\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">#2</text></g><g><rect x=\"231.0\" y=\"148.6\" width=\"38.0\" height=\"67.4\" rx=\"3\" fill=\"#2dd4bf\"><title>Chunk #3: 446 chars (57 words)</title></rect><text x=\"250.0\" y=\"144.6\" fill=\"#cbd5e1\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">446</text><text x=\"250.0\" y=\"228.0\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">#3</text></g><g><rect x=\"301.0\" y=\"150.9\" width=\"38.0\" height=\"65.1\" rx=\"3\" fill=\"#c084fc\"><title>Chunk #4: 431 chars (51 words)</title></rect><text x=\"320.0\" y=\"146.9\" fill=\"#cbd5e1\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">431</text><text x=\"320.0\" y=\"228.0\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">#4</text></g><g><rect x=\"371.0\" y=\"148.8\" width=\"38.0\" height=\"67.2\" rx=\"3\" fill=\"#f472b6\"><title>Chunk #5: 445 chars (61 words)</title></rect><text x=\"390.0\" y=\"144.8\" fill=\"#cbd5e1\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">445</text><text x=\"390.0\" y=\"228.0\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">#5</text></g><g><rect x=\"441.0\" y=\"150.7\" width=\"38.0\" height=\"65.3\" rx=\"3\" fill=\"#38bdf8\"><title>Chunk #6: 432 chars (61 words)</title></rect><text x=\"460.0\" y=\"146.7\" fill=\"#cbd5e1\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">432</text><text x=\"460.0\" y=\"228.0\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">#6</text></g><g><rect x=\"511.0\" y=\"148.2\" width=\"38.0\" height=\"67.8\" rx=\"3\" fill=\"#60a5fa\"><title>Chunk #7: 449 chars (58 words)</title></rect><text x=\"530.0\" y=\"144.2\" fill=\"#cbd5e1\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">449</text><text x=\"530.0\" y=\"228.0\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">#7</text></g><g><rect x=\"581.0\" y=\"166.6\" width=\"38.0\" height=\"49.4\" rx=\"3\" fill=\"#2dd4bf\"><title>Chunk #8: 327 chars (42 words)</title></rect><text x=\"600.0\" y=\"162.6\" fill=\"#cbd5e1\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">327</text><text x=\"600.0\" y=\"228.0\" fill=\"#94a3b8\" font-size=\"9.5\" font-family=\"monospace\" text-anchor=\"middle\">#8</text></g> </svg></div></div>\n\n<span class=\"paragraph\"><marimo-accordion data-labels='[&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003e\ud83d\udcc4 Expand to Inspect Individual Chunk Cards (8 chunks)&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;]' data-multiple='false' data-expanded='[&quot;0&quot;]'><div> <div style=\"background:#1e293b;border-left:4px solid #38bdf8;padding:10px 14px;margin-bottom:8px;border-radius:6px;color:#f1f5f9;font-size:13px;\"> <div style=\"font-weight:700;color:#38bdf8;margin-bottom:4px;\"> Chunk #1 \u00b7 Section: Vector &amp; Full-Text Search with DuckDB <span style=\"float:right;font-weight:400;color:#cbd5e1;\"> chars 0..39 (39 chars, 7 words) \u00b7 overlap=0 chars </span> </div> <div style=\"white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45;\"># Vector &amp; Full-Text Search with DuckDB</div> </div>  <div style=\"background:#172554;border-left:4px solid #60a5fa;padding:10px 14px;margin-bottom:8px;border-radius:6px;color:#f1f5f9;font-size:13px;\"> <div style=\"font-weight:700;color:#60a5fa;margin-bottom:4px;\"> Chunk #2 \u00b7 Section: 1. Why DuckDB for Local RAG? <span style=\"float:right;font-weight:400;color:#cbd5e1;\"> chars 41..490 (449 chars, 63 words) \u00b7 overlap=0 chars </span> </div> <div style=\"white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45;\">## 1. Why DuckDB for Local RAG? When moving beyond a 50-line in-memory Python list (<code>VECTOR_DB = []</code>), many tutorials jump straight to heavy client-server vector databases or cloud services. <strong>DuckDB</strong> offers a zero-configuration, embedded SQL database that runs in-process inside Python (<code>import duckdb</code>) and stores your entire RAG corpus\u2014text chunks, metadata JSON, vector embeddings, and full-text indexes\u2014inside a single portable <code>.duckdb</code> file.</div> </div>  <div style=\"background:#134e4a;border-left:4px solid #2dd4bf;padding:10px 14px;margin-bottom:8px;border-radius:6px;color:#f1f5f9;font-size:13px;\"> <div style=\"font-weight:700;color:#2dd4bf;margin-bottom:4px;\"> Chunk #3 \u00b7 Section: 2. Storing Fixed-Size Embeddings in DuckDB (Part 1) <span style=\"float:right;font-weight:400;color:#cbd5e1;\"> chars 492..938 (446 chars, 57 words) \u00b7 overlap=0 chars </span> </div> <div style=\"white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45;\">## 2. Storing Fixed-Size Embeddings in DuckDB DuckDB natively supports fixed-size <code>FLOAT[N]</code> array columns. For example, if your embedding model produces 384-dimensional or 768-dimensional vectors, you define your table as:  <code>sql CREATE TABLE rag_chunks ( chunk_id INTEGER PRIMARY KEY, doc_source VARCHAR, section_title VARCHAR, chunk_text VARCHAR, embedding FLOAT[128] );</code>  To score chunks against a query vector, DuckDB</div> </div>  <div style=\"background:#3b0764;border-left:4px solid #c084fc;padding:10px 14px;margin-bottom:8px;border-radius:6px;color:#f1f5f9;font-size:13px;\"> <div style=\"font-weight:700;color:#c084fc;margin-bottom:4px;\"> Chunk #4 \u00b7 Section: 2. Storing Fixed-Size Embeddings in DuckDB (Part 2) <span style=\"float:right;font-weight:400;color:#cbd5e1;\"> chars 878..1309 (431 chars, 51 words) \u00b7 overlap=60 chars </span> </div> <div style=\"white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45;\">[128] ); <code>To score chunks against a query vector, DuckDB provides the built-in `array_cosine_similarity(vec1, vec2)` function, which is vectorized and executes in milliseconds across tens of thousands of chunks without leaving SQL:</code>sql SELECT chunk_id, doc_source, chunk_text, array_cosine_similarity(embedding, $query_vec::FLOAT[128]) AS vector_score FROM rag_chunks ORDER BY vector_score DESC LIMIT 5; <code>``&lt;/div&gt; &lt;/div&gt;  &lt;div style=\"background:#3f2e1e;border-left:4px solid #f59e0b;padding:10px 14px;margin-bottom:8px;border-radius:6px;color:#f1f5f9;font-size:13px;\"&gt; &lt;div style=\"font-weight:700;color:#f59e0b;margin-bottom:4px;\"&gt; Chunk #5 \u00b7 Section: 3. Troubleshooting Common DuckDB Vector Errors (Part 1) &lt;span style=\"float:right;font-weight:400;color:#cbd5e1;\"&gt; chars 1311..1756 (445 chars, 61 words) \u00b7 overlap=0 chars &lt;/span&gt; &lt;/div&gt; &lt;div style=\"white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45;\"&gt;## 3. Troubleshooting Common DuckDB Vector Errors When building a DuckDB vector pipeline, watch out for two specific diagnostic codes: - **Diagnostic</code>ERR-VEC-768<code>(Dimension Mismatch)**: Occurs when you index documents using a 768-dimension embedding model (like</code>bge-base-en-v1.5<code>) but query the table with a 384-dimension model (like</code>all-MiniLM-L6-v2<code>). Always store the embedding model identifier in your table metadata and enforce a single&lt;/div&gt; &lt;/div&gt;  &lt;div style=\"background:#1e293b;border-left:4px solid #38bdf8;padding:10px 14px;margin-bottom:8px;border-radius:6px;color:#f1f5f9;font-size:13px;\"&gt; &lt;div style=\"font-weight:700;color:#38bdf8;margin-bottom:4px;\"&gt; Chunk #6 \u00b7 Section: 3. Troubleshooting Common DuckDB Vector Errors (Part 2) &lt;span style=\"float:right;font-weight:400;color:#cbd5e1;\"&gt; chars 1696..2128 (432 chars, 61 words) \u00b7 overlap=60 chars &lt;/span&gt; &lt;/div&gt; &lt;div style=\"white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45;\"&gt;model identifier in your table metadata and enforce a single embedding dimension across indexing and retrieval. - **Diagnostic</code>ERR-CHUNK-004<code>(Empty or Null Vector Norm)**: Occurs when whitespace-only chunks are embedded and produce a zero vector (</code>[0.0, 0.0, ...]<code>), causing</code>array_cosine_similarity<code>to return</code>NULL<code>or</code>NaN<code>because of division by zero. Always strip and filter chunks shorter than 15 characters before indexing.&lt;/div&gt; &lt;/div&gt;  &lt;div style=\"background:#172554;border-left:4px solid #60a5fa;padding:10px 14px;margin-bottom:8px;border-radius:6px;color:#f1f5f9;font-size:13px;\"&gt; &lt;div style=\"font-weight:700;color:#60a5fa;margin-bottom:4px;\"&gt; Chunk #7 \u00b7 Section: 4. DuckDB Full-Text Search (BM25) and the</code>vss<code>Extension (Part 1) &lt;span style=\"float:right;font-weight:400;color:#cbd5e1;\"&gt; chars 2130..2579 (449 chars, 58 words) \u00b7 overlap=0 chars &lt;/span&gt; &lt;/div&gt; &lt;div style=\"white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45;\"&gt;## 4. DuckDB Full-Text Search (BM25) and the</code>vss<code>Extension In addition to exact</code>array_cosine_similarity<code>scans, DuckDB provides two powerful extensions for scaling RAG: 1. **</code>fts<code>(Full-Text Search)**: Builds an inverted index over</code>chunk_text<code>and calculates Okapi **BM25** lexical relevance scores using</code>fts_main_rag_chunks.match_bm25(chunk_id, &#x27;query terms&#x27;)<code>. Default BM25 parameters in DuckDB are</code>k1 = 1.2<code>(term frequency saturation, code&lt;/div&gt; &lt;/div&gt;  &lt;div style=\"background:#134e4a;border-left:4px solid #2dd4bf;padding:10px 14px;margin-bottom:8px;border-radius:6px;color:#f1f5f9;font-size:13px;\"&gt; &lt;div style=\"font-weight:700;color:#2dd4bf;margin-bottom:4px;\"&gt; Chunk #8 \u00b7 Section: 4. DuckDB Full-Text Search (BM25) and the</code>vss<code>Extension (Part 2) &lt;span style=\"float:right;font-weight:400;color:#cbd5e1;\"&gt; chars 2519..2846 (327 chars, 42 words) \u00b7 overlap=60 chars &lt;/span&gt; &lt;/div&gt; &lt;div style=\"white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45;\"&gt;rs in DuckDB are</code>k1 = 1.2<code>(term frequency saturation, code</code>BM25-K1-1.2<code>) and</code>b = 0.75<code>(document length normalization). 2. **</code>vss<code>(Vector Similarity Search)**: Adds Hierarchical Navigable Small World (**HNSW**) approximate nearest-neighbor indexes on</code>FLOAT[N]` columns for sub-millisecond retrieval on million-row tables.</div> </div> </div></marimo-accordion></span></span>"
          }
        }
      ],
